{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized single-vendor store administrator record.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "role": { "type": "string", "enum": ["admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private customer profile containing PII and saved Bangladesh delivery addresses.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "phone": { "type": "string", "pattern": "^(\\+?880|0)1[3-9][0-9]{8}$", "maxLength": 20 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "provider": { "type": "string", "maxLength": 40 },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "division": { "type": "string", "maxLength": 60 },
        "district": { "type": "string", "maxLength": 60 },
        "upazila": { "type": "string", "maxLength": 80 },
        "area": { "type": "string", "maxLength": 100 },
        "fullAddress": { "type": "string", "maxLength": 300 },
        "pushEnabled": { "type": "boolean" },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "role", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Single-vendor catalog item published by the store owner.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 160 },
        "nameBn": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 160 },
        "sku": { "type": "string", "minLength": 2, "maxLength": 64 },
        "shortDescription": { "type": "string", "maxLength": 300 },
        "description": { "type": "string", "maxLength": 5000 },
        "categoryId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "brandId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "regularPrice": { "type": "number" },
        "discountedPrice": { "type": "number" },
        "images": { "type": "array" },
        "videoUrl": { "type": "string", "maxLength": 500 },
        "variants": { "type": "array" },
        "stockQuantity": { "type": "number" },
        "specifications": { "type": "array" },
        "shippingInfo": { "type": "string", "maxLength": 300 },
        "isFeatured": { "type": "boolean" },
        "isTrending": { "type": "boolean" },
        "isFlashSale": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "seoTitle": { "type": "string", "maxLength": 120 },
        "seoDescription": { "type": "string", "maxLength": 240 },
        "ratingAvg": { "type": "number" },
        "ratingCount": { "type": "number" },
        "soldCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug", "sku", "categoryId", "brandId", "regularPrice", "stockQuantity", "isActive", "createdAt", "updatedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category definition.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "nameBn": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 80 },
        "icon": { "type": "string", "maxLength": 40 },
        "image": { "type": "string", "maxLength": 500 },
        "sortOrder": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["name", "slug", "isActive"]
    },
    "Brand": {
      "title": "Brand",
      "description": "Official product brand.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 80 },
        "logo": { "type": "string", "maxLength": 500 },
        "isActive": { "type": "boolean" }
      },
      "required": ["name", "slug", "isActive"]
    },
    "Cart": {
      "title": "Cart",
      "description": "Customer shopping cart storing item IDs, variants, and quantities only.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "items": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "items", "updatedAt"]
    },
    "Wishlist": {
      "title": "Wishlist",
      "description": "Customer saved product IDs.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "productIds": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "productIds", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order with immutable price snapshot and Bangladesh delivery info.",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string", "minLength": 6, "maxLength": 40 },
        "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "customerInfo": { "type": "object" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discountAmount": { "type": "number" },
        "couponCode": { "type": "string", "maxLength": 40 },
        "deliveryCharge": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["cod"] },
        "paymentStatus": { "type": "string", "enum": ["unpaid", "paid", "refunded", "failed"] },
        "orderStatus": {
          "type": "string",
          "enum": ["Pending", "Confirmed", "Processing", "Packed", "Shipped", "Out for Delivery", "Delivered", "Cancelled", "Return Requested", "Returned", "Refunded"]
        },
        "verificationStatus": {
          "type": "string",
          "enum": ["Order Created", "Verification Pending", "Verified", "Verification Failed"]
        },
        "verificationMessage": { "type": "string", "maxLength": 300 },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "trackingCode": { "type": "string", "maxLength": 80 },
        "timeline": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderNumber", "idempotencyKey", "userId", "customerInfo", "items", "subtotal", "discountAmount", "deliveryCharge", "totalAmount", "paymentMethod", "paymentStatus", "orderStatus", "createdAt", "updatedAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Product review submitted by an authenticated customer.",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "minLength": 3, "maxLength": 1000 },
        "isApproved": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "userId", "userName", "rating", "comment", "isApproved", "createdAt"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount coupon managed by the store owner.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z0-9_-]+$", "maxLength": 40 },
        "type": { "type": "string", "enum": ["percentage", "fixed"] },
        "value": { "type": "number" },
        "minPurchase": { "type": "number" },
        "maxDiscount": { "type": "number" },
        "usageLimit": { "type": "number" },
        "usedCount": { "type": "number" },
        "perCustomerLimit": { "type": "number" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "isActive": { "type": "boolean" }
      },
      "required": ["code", "type", "value", "minPurchase", "isActive"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Promotional homepage hero or offer banner.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "titleBn": { "type": "string", "maxLength": 200 },
        "subtitle": { "type": "string", "maxLength": 240 },
        "badgeText": { "type": "string", "maxLength": 40 },
        "imageUrl": { "type": "string", "maxLength": 600 },
        "linkUrl": { "type": "string", "maxLength": 300 },
        "placement": { "type": "string", "enum": ["hero", "promo", "flash_sale"] },
        "sortOrder": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["title", "imageUrl", "placement", "isActive"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Customer or admin in-app notification.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "targetRole": { "type": "string", "enum": ["customer", "admin"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "body": { "type": "string", "minLength": 1, "maxLength": 500 },
        "type": { "type": "string", "maxLength": 40 },
        "isRead": { "type": "boolean" },
        "link": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "targetRole", "title", "body", "isRead", "createdAt"]
    },
    "ReturnRequest": {
      "title": "ReturnRequest",
      "description": "Customer return request linked to an order.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "orderNumber": { "type": "string", "minLength": 1, "maxLength": 40 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reason": { "type": "string", "minLength": 5, "maxLength": 500 },
        "status": { "type": "string", "enum": ["requested", "approved", "rejected", "completed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderId", "orderNumber", "userId", "reason", "status", "createdAt"]
    },
    "RefundRecord": {
      "title": "RefundRecord",
      "description": "Admin-managed refund record.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "returnId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "amount": { "type": "number" },
        "method": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["pending", "processed", "failed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderId", "userId", "amount", "method", "status", "createdAt"]
    },
    "StoreSetting": {
      "title": "StoreSetting",
      "description": "Storefront, shipping, payment, and homepage configuration.",
      "type": "object",
      "properties": {
        "key": { "type": "string", "maxLength": 60 },
        "data": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["key", "data", "updatedAt"]
    },
    "AdminLog": {
      "title": "AdminLog",
      "description": "Immutable audit log of admin mutations.",
      "type": "object",
      "properties": {
        "adminUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "adminEmail": { "type": "string", "maxLength": 200 },
        "action": { "type": "string", "minLength": 2, "maxLength": 120 },
        "targetCollection": { "type": "string", "maxLength": 80 },
        "targetId": { "type": "string", "maxLength": 128 },
        "summary": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["adminUid", "action", "targetCollection", "targetId", "createdAt"]
    },
    "NewsletterSubscriber": {
      "title": "NewsletterSubscriber",
      "description": "Newsletter subscription email.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "isActive": { "type": "boolean" },
        "subscribedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "isActive", "subscribedAt"]
    }
  },
  "firestore": {
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authorized admin UIDs verified by Firestore rules."
    },
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Customer profile and PII isolated to owner and admin."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Store catalog products."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Product categories."
    },
    "/brands/{brandId}": {
      "schema": { "$ref": "#/entities/Brand" },
      "description": "Official product brands."
    },
    "/carts/{uid}": {
      "schema": { "$ref": "#/entities/Cart" },
      "description": "Persistent shopping cart keyed by customer UID."
    },
    "/wishlists/{uid}": {
      "schema": { "$ref": "#/entities/Wishlist" },
      "description": "Persistent wishlist keyed by customer UID."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders with immutable item snapshots."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Customer product reviews."
    },
    "/coupons/{code}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Promotional discount coupons."
    },
    "/banners/{bannerId}": {
      "schema": { "$ref": "#/entities/Banner" },
      "description": "Homepage and promotional banners."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Customer and admin notifications."
    },
    "/returns/{returnId}": {
      "schema": { "$ref": "#/entities/ReturnRequest" },
      "description": "Customer return requests."
    },
    "/refunds/{refundId}": {
      "schema": { "$ref": "#/entities/RefundRecord" },
      "description": "Refund records."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSetting" },
      "description": "Global, shipping, payment, and homepage settings."
    },
    "/admin_logs/{logId}": {
      "schema": { "$ref": "#/entities/AdminLog" },
      "description": "Audit logs of admin actions."
    },
    "/newsletter_subscribers/{subscriberId}": {
      "schema": { "$ref": "#/entities/NewsletterSubscriber" },
      "description": "Newsletter subscriber emails."
    }
  }
}
