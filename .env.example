# GEMINI_API_KEY: Optional server-side Gemini API key if AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL of the application.
APP_URL="MY_APP_URL"

# Firebase App Check (ReCAPTCHA v3 / Enterprise site key - public)
VITE_FIREBASE_APP_CHECK_KEY=""

# Firebase Cloud Messaging Web Push VAPID key (public)
VITE_FIREBASE_VAPID_KEY=""

# Payment Gateways (Server-side secrets ONLY - disabled until configured)
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
NAGAD_MERCHANT_ID=""
NAGAD_PRIVATE_KEY=""
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWD=""
PAYMENT_WEBHOOK_SECRET=""

# Firebase Admin Provisioning (for local CLI script scripts/provision-admin.ts)
FIREBASE_SERVICE_ACCOUNT_PATH=""
